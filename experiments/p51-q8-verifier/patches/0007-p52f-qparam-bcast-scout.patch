+def _build_msg_q8_m3_bcast_kernel(dtype, nsg: int):
+    """Q8 GS64 M3 BN4 MSG kernel with 8-lane qparam broadcast."""
+    import mlx.core as mx
+
+    key = (
+        "msg_q8_m3_bcast",
+        dtype,
+        nsg,
+    )
+
+    if key in _KERNEL_CACHE:
+        return _KERNEL_CACHE[key]
+
+    source = r"""
+        using namespace metal;
+
+        constexpr int GS = 64;
+        constexpr int NSG = __NSG__;
+
+        uint sg =
+            simdgroup_index_in_threadgroup;
+        ushort lane =
+            ushort(thread_index_in_simdgroup);
+        uint tg_n =
+            threadgroup_position_in_grid.y;
+
+        int K = int(K_size);
+        int N = int(N_size);
+
+        int K_by_p = K / 8;
+        int K_by_gs = K / GS;
+
+        int n0 =
+            (int(tg_n) * NSG + int(sg)) * 4;
+
+        if (n0 + 3 >= N) {
+            return;
+        }
+
+        float acc[12];
+
+        _Pragma("unroll")
+        for (int i = 0; i < 12; ++i) {
+            acc[i] = 0.0f;
+        }
+
+        using Vec8 = vec<T, 8>;
+
+        const device Vec8 *xv =
+            (const device Vec8*)x;
+
+        for (
+            int pair = int(lane);
+            pair < K_by_p;
+            pair += 32
+        ) {
+            int k_base = pair * 8;
+
+            /*
+             * GS=64 => 8 adjacent pair indices share one
+             * quantization group.
+             *
+             * pair = lane + 32*t, therefore lanes:
+             *   0..7, 8..15, 16..23, 24..31
+             * each share gi on every loop iteration.
+             */
+            int gi = k_base / GS;
+
+            Vec8 v0 =
+                xv[(0 * K + k_base) / 8];
+            Vec8 v1 =
+                xv[(1 * K + k_base) / 8];
+            Vec8 v2 =
+                xv[(2 * K + k_base) / 8];
+
+            ushort src_lane =
+                ushort((int(lane) / 8) * 8);
+
+            float s0 = 0.0f;
+            float s1 = 0.0f;
+            float s2 = 0.0f;
+            float s3 = 0.0f;
+
+            float b0 = 0.0f;
+            float b1 = 0.0f;
+            float b2 = 0.0f;
+            float b3 = 0.0f;
+
+            if (lane == src_lane) {
+                s0 = float(
+                    scales[
+                        (n0 + 0) * K_by_gs + gi
+                    ]
+                );
+                s1 = float(
+                    scales[
+                        (n0 + 1) * K_by_gs + gi
+                    ]
+                );
+                s2 = float(
+                    scales[
+                        (n0 + 2) * K_by_gs + gi
+                    ]
+                );
+                s3 = float(
+                    scales[
+                        (n0 + 3) * K_by_gs + gi
+                    ]
+                );
+
+                b0 = float(
+                    biases[
+                        (n0 + 0) * K_by_gs + gi
+                    ]
+                );
+                b1 = float(
+                    biases[
+                        (n0 + 1) * K_by_gs + gi
+                    ]
+                );
+                b2 = float(
+                    biases[
+                        (n0 + 2) * K_by_gs + gi
+                    ]
+                );
+                b3 = float(
+                    biases[
+                        (n0 + 3) * K_by_gs + gi
+                    ]
+                );
+            }
+
+            s0 = simd_shuffle(s0, src_lane);
+            s1 = simd_shuffle(s1, src_lane);
+            s2 = simd_shuffle(s2, src_lane);
+            s3 = simd_shuffle(s3, src_lane);
+
+            b0 = simd_shuffle(b0, src_lane);
+            b1 = simd_shuffle(b1, src_lane);
+            b2 = simd_shuffle(b2, src_lane);
+            b3 = simd_shuffle(b3, src_lane);
+
+            _Pragma("unroll")
+            for (
+                int wsel = 0;
+                wsel < 2;
+                ++wsel
+            ) {
+                int koff = wsel * 4;
+
+                uint32_t p0 =
+                    w_q[
+                        (n0 + 0) * (K / 4)
+                        + pair * 2 + wsel
+                    ];
+                uint32_t p1 =
+                    w_q[
+                        (n0 + 1) * (K / 4)
+                        + pair * 2 + wsel
+                    ];
+                uint32_t p2 =
+                    w_q[
+                        (n0 + 2) * (K / 4)
+                        + pair * 2 + wsel
+                    ];
+                uint32_t p3 =
+                    w_q[
+                        (n0 + 3) * (K / 4)
+                        + pair * 2 + wsel
+                    ];
+
+                _Pragma("unroll")
+                for (int ki = 0; ki < 4; ++ki) {
+                    int shift = ki * 8;
+
+                    float w0 =
+                        float(
+                            (p0 >> shift) & 0xFFu
+                        ) * s0 + b0;
+
+                    float w1 =
+                        float(
+                            (p1 >> shift) & 0xFFu
+                        ) * s1 + b1;
+
+                    float w2 =
+                        float(
+                            (p2 >> shift) & 0xFFu
+                        ) * s2 + b2;
+
+                    float w3 =
+                        float(
+                            (p3 >> shift) & 0xFFu
+                        ) * s3 + b3;
+
+                    int xi = ki + koff;
+
+                    acc[0]  += float(v0[xi]) * w0;
+                    acc[1]  += float(v1[xi]) * w0;
+                    acc[2]  += float(v2[xi]) * w0;
+
+                    acc[3]  += float(v0[xi]) * w1;
+                    acc[4]  += float(v1[xi]) * w1;
+                    acc[5]  += float(v2[xi]) * w1;
+
+                    acc[6]  += float(v0[xi]) * w2;
+                    acc[7]  += float(v1[xi]) * w2;
+                    acc[8]  += float(v2[xi]) * w2;
+
+                    acc[9]  += float(v0[xi]) * w3;
+                    acc[10] += float(v1[xi]) * w3;
+                    acc[11] += float(v2[xi]) * w3;
+                }
+            }
+        }
+
+        _Pragma("unroll")
+        for (int i = 0; i < 12; ++i) {
+            acc[i] = simd_sum(acc[i]);
+        }
+
+        if (lane < 12) {
+            int j = int(lane) / 3;
+            int row =
+                int(lane) - j * 3;
+
+            y[row * N + n0 + j] =
+                T(acc[int(lane)]);
+        }
+    """
+
+    source = source.replace(
+        "__NSG__",
+        str(nsg),
+    )
+
+    dtype_tag = {
+        mx.bfloat16: "bf16",
+        mx.float16: "fp16",
+    }.get(dtype, "unk")
+
+    kernel = mx.fast.metal_kernel(
+        name=(
+            f"omlx_vk_bcast_m3_q8_"
+            f"nsg{nsg}_gs64_{dtype_tag}"
+        ),
+        input_names=[
+            "x",
+            "w_q",
+            "scales",
+            "biases",
+            "K_size",
+            "N_size",
+        ],
         output_names=["y"],
         source=source,
     )
+
     _KERNEL_CACHE[key] = kernel
     return kernel
 
