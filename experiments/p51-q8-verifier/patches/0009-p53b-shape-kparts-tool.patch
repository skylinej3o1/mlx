+def _parse_shape_kparts(raw: str):
+    out = {}
+
+    for item in raw.split(","):
+        item = item.strip()
+
+        if not item:
+            continue
+
+        if ":" not in item:
+            raise RuntimeError(
+                f"invalid verifier KPARTS shape "
+                f"{item!r}; expected KxN:KP"
+            )
+
+        shape, kp_raw = item.split(":", 1)
+
+        parts = shape.lower().split("x")
+
+        if len(parts) != 2:
+            raise RuntimeError(
+                f"invalid verifier KPARTS shape "
+                f"{shape!r}; expected KxN"
+            )
+
+        k = int(parts[0])
+        n = int(parts[1])
+        kp = int(kp_raw)
+
+        if kp not in (1, 2, 4, 8):
+            raise RuntimeError(
+                f"invalid KPARTS {kp!r} "
+                f"for shape {shape!r}"
+            )
+
+        out[(k, n)] = kp
+
+    return out
+
+
+_VERIFY_SHAPE_KPARTS = _parse_shape_kparts(
+    os.environ.get(
+        "OMLX_VERIFY_KPARTS_SHAPES",
+        "",
+    )
+)
+
