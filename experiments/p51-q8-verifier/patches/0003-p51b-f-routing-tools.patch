+def _parse_extra_shapes(raw: str):
+    out = set()
+
+    for item in raw.split(","):
+        item = item.strip()
+
+        if not item:
+            continue
+
+        parts = item.lower().split("x")
+
+        if len(parts) != 2:
+            raise RuntimeError(
+                f"invalid verifier shape {item!r}; expected KxN"
+            )
+
+        out.add(
+            (
+                int(parts[0]),
+                int(parts[1]),
+            )
+        )
+
+    return frozenset(out)
+
+
+_EXTRA_ROUTE_SHAPES = _parse_extra_shapes(
+    os.environ.get(
